{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/css/(.*)",   "dest": "/css/$1"   },
    { "src": "/js/(.*)",    "dest": "/js/$1"    },
    { "src": "/image/(.*)", "dest": "/image/$1" },
    { "src": "/(.*\\.ico)", "dest": "/$1"       },
    { "src": "/(.*\\.png)", "dest": "/$1"       },
    { "src": "/(.*\\.svg)", "dest": "/$1"       },
    { "src": "/(.*)",       "dest": "/api/index.php" }
  ]
}
